<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!--
   <include domain="sharedpref" path="."/>
   <exclude domain="sharedpref" path="device.xml"/>
-->
    <!-- 🆕 Issue #128 Teil 3: Das Aktivitätsprotokoll beschreibt die Historie DIESES Geräts,
         nicht die Notizinhalte. Aus einem Backup zurückgespielt behauptet es Ereignisse, die auf
         dem neuen Gerät nie stattgefunden haben (und die deviceId ist dort eine andere). -->
    <exclude domain="file" path="activity.jsonl"/>
    <exclude domain="file" path="activity.jsonl.1"/>
</full-backup-content>