<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!--
   <include domain="sharedpref" path="."/>
   <exclude domain="sharedpref" path="device.xml"/>
-->
    <!-- 🆕 Issue #128 Teil 3: Das Aktivitätsprotokoll beschreibt die Historie DIESES Geräts,
         nicht die Notizinhalte. Aus einem Backup zurückgespielt behauptet es Ereignisse, die auf
         dem neuen Gerät nie stattgefunden haben (und die deviceId ist dort eine andere). -->
    <exclude domain="file" path="activity.jsonl"/>
    <exclude domain="file" path="activity.jsonl.1"/>

    <!-- Das Tink-Keyset der EncryptedSharedPreferences ist mit einem AndroidKeyStore-MasterKey
         verschlüsselt, der sich nicht exportieren lässt und deshalb nie mitkommt. Restauriert
         landet hier also eine Datei, die auf dem neuen Gerät dauerhaft unentschlüsselbar ist.
         Nicht sichern: die Credentials kommen ohnehin aus den regulären Prefs zurück. -->
    <exclude domain="sharedpref" path="simple_notes_secure_prefs.xml"/>

    <!-- 🆕 v2.17.0 (WP-3): Klartext-Notnagel, wenn der AndroidKeyStore nicht nutzbar ist. Vorher
         landeten die Credentials in diesem Fall in simple_notes_prefs.xml — also mitten in den
         gesicherten Settings. Das Passwort konnte so im Klartext in ein Cloud-Backup wandern. -->
    <exclude domain="sharedpref" path="simple_notes_credentials_fallback.xml"/>

    <!-- Der AndroidKeyStore-Key ist nicht exportierbar und kommt nie mit. Restauriert wäre die
         Datei auf dem neuen Gerät unentschlüsselbar. -->
    <exclude domain="sharedpref" path="simple_notes_credentials.xml"/>
</full-backup-content>