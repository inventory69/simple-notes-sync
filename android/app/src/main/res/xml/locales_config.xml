<?xml version="1.0" encoding="utf-8"?>
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Default/Fallback language -->
    <locale android:name="en" />
    <!-- Supported languages. Speist den System-Sprachwähler (Android 13+).
         Aufnahme erst ab >= 40% Übersetzungsgrad, sonst sieht der Nutzer eine
         fast komplett englische UI. Darunter (Stand v2.14.0): pt-rBR 32%, nl 9%, hi 4%, et 2%.
         Muss synchron zu localeFilters (build.gradle.kts) und der Fallback-Liste
         in LanguageSettingsScreen.kt gehalten werden. -->
    <locale android:name="de" />
    <locale android:name="es" />
    <locale android:name="fr" />
    <locale android:name="in" />
    <locale android:name="it" />
    <locale android:name="nb" />
    <locale android:name="pl" />
    <locale android:name="ru" />
    <locale android:name="tr" />
    <locale android:name="uk" />
    <locale android:name="zh-Hans" />
</locale-config>
